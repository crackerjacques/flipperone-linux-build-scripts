# flipctl on the RG Vita Pro screen. The Vita has none of the Flipper One's SPI panel,
# so flipctl.service is off there (flipctl.service.d/10-not-on-vita.conf); this shows
# flipctl in a sway session on the main screen instead, scaled up to fill it.
# vita-session swaps it for Plasma and back.
[Unit]
Description=flipctl on the RG Vita Pro screen, in sway
ConditionFirmware=device-tree-compatible(anbernic,rg-vita-pro)
After=systemd-logind.service systemd-user-sessions.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=user
Group=user
SupplementaryGroups=input video render
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/games

# This is what the Vita boots to, @Desktop included: sddm waits there until
# vita-session hands it the screen. Only @TV-Media-Box keeps it, for kodi.service.
ExecCondition=/bin/sh -c '! systemctl -q is-enabled kodi.service'
# Pad buttons as flipctl's keys while it holds the screen, and back afterwards.
ExecStartPre=+/bin/sh -c 'echo PAD2KEY_MODE=flipctl > /run/vita-pad2key.env; systemctl --no-block try-restart vita-pad2key.service'
ExecStart=/usr/bin/sway -c /usr/local/share/vita/sway-flipctl.conf
ExecStopPost=+/bin/sh -c 'rm -f /run/vita-pad2key.env; systemctl --no-block try-restart vita-pad2key.service'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
